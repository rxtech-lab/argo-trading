# ── RxLab OAuth (register a client with redirect URI {APP_URL}/api/auth/callback/rxlab) ──
AUTH_ISSUER=https://auth.rxlab.app
AUTH_CLIENT_ID=
# OAuth client secret. - secret
AUTH_CLIENT_SECRET=
# NextAuth secret (openssl rand -base64 32). - secret
AUTH_SECRET=
# Public base URL of this deployment (used by Auth.js for callbacks).
AUTH_URL=http://localhost:3000

# ── Turso (libSQL) ──
# libsql://<db>.turso.io
TURSO_DATABASE_URL=
# Turso auth token. - secret
TURSO_AUTH_TOKEN=

# ── Autopilot release API (macOS download) ──
# The download link for approved users is resolved from the latest release of
# the repo below via the Autopilot release API. DOWNLOAD_URL is only used as a
# fallback when the API is unreachable or no token is set for a private listing.
AUTOPILOT_BASE_URL=https://autopilot.rxlab.app
# Repo whose latest release is offered for download (owner/repo).
AUTOPILOT_RELEASE_REPO=rxtech-lab/argo-trading-macOS
# Bearer token (dpat_...) with release:file:read scope. Required when the repo's
# version list is private. - secret
AUTOPILOT_TOKEN=

# ── Resend (transactional email) ──
# API key used to send the waitlist-approval email. If unset, approval still
# works but no email is sent. - secret
RESEND_API_KEY=
# From address for outgoing mail. Must be a Resend-verified domain in prod;
# defaults to Resend's onboarding@resend.dev sandbox sender.
EMAIL_FROM=RxArgo <onboarding@resend.dev>